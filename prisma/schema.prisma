generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  password           String
  role               String     @default("user")
  resetToken         String?
  resetTokenExpiry   DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  googleConnected    Boolean    @default(false)
  googleEmail        String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  dailyQuotaLimit    Int        @default(500)
  emailsSentToday    Int        @default(0)
  lastQuotaReset     DateTime   @default(now())
  campaigns          Campaign[]

  @@map("users")
}

model Campaign {
  id               String              @id @default(uuid())
  subject          String
  body             String
  recipients       String
  status           String              @default("draft")
  sentCount        Int                 @default(0)
  totalCount       Int                 @default(0)
  logs             String              @default("")
  userId           String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientRecords CampaignRecipient[]
  openEvents       CampaignOpenEvent[]

  @@map("campaigns")
}

model CampaignRecipient {
  id         String              @id @default(uuid())
  campaignId String
  email      String
  status     String              @default("sent")
  variables  Json?
  opened     Boolean             @default(false)
  openedAt   DateTime?
  openCount  Int                 @default(0)
  createdAt  DateTime            @default(now())
  campaign   Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  openEvents CampaignOpenEvent[]

  @@unique([campaignId, email])
  @@index([campaignId])
  @@index([campaignId, email])
  @@map("campaign_recipients")
}

model CampaignOpenEvent {
  id          String            @id @default(uuid())
  campaignId  String
  recipientId String
  openedAt    DateTime          @default(now())
  ipAddress   String?
  userAgent   String?
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient   CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, recipientId])
  @@index([openedAt])
  @@map("campaign_open_events")
}
