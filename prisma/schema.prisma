generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  password           String
  role               String     @default("user")
  resetToken         String?
  resetTokenExpiry   DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  googleConnected    Boolean    @default(false)
  googleEmail        String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  dailyQuotaLimit    Int        @default(500)
  emailsSentToday    Int        @default(0)
  lastQuotaReset     DateTime   @default(now())
  campaigns          Campaign[]

  @@map("users")
}

model Campaign {
  id               String              @id @default(uuid())
  subject          String
  body             String
  recipients       String
  status           String              @default("draft")
  sentCount        Int                 @default(0)
  bounceCount      Int                 @default(0)
  totalCount       Int                 @default(0)
  logs             String              @default("")
  userId           String
  relaunchedFromId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  relaunchedFrom   Campaign?           @relation("Relaunches", fields: [relaunchedFromId], references: [id], onDelete: SetNull)
  relaunches       Campaign[]          @relation("Relaunches")
  recipientsList   CampaignRecipient[]
  events           CampaignEvent[]

  @@map("campaigns")
}

model CampaignRecipient {
  id           String    @id @default(uuid())
  campaignId   String
  email        String
  variables    String?
  status       String    @default("pending") // pending | sent | bounced | failed
  sentAt       DateTime?
  errorMessage String?
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, email])
  @@map("campaign_recipients")
}

model CampaignEvent {
  id            String   @id @default(uuid())
  campaignId    String
  recipientEmail String
  type          String   // open | click | bounce
  targetUrl     String?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, type])
  @@index([campaignId, recipientEmail])
  @@index([campaignId, type, recipientEmail])
  @@index([createdAt])
  @@map("campaign_events")
}
